script/source = "extends SubViewport


# 节点首次进入场景树时调用。
func _ready() -> void:
	var camera = get_node(\"3D世界/玩家/顶视图摄像机枢轴/顶视图摄像机\");
	add_child(camera)


# 每帧调用。delta 为距上一帧经过的时间。
func _process(delta: float) -> void:
	pass
"

