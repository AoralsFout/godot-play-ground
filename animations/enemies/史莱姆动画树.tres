; 史莱姆独立动画图，组织待机、移动、攻击和死亡状态。
; 场景和资源参数由 Godot 编辑器维护，关联脚本说明可调属性的用途。

[gd_resource type="AnimationNodeBlendTree" load_steps=16 format=3]

[sub_resource type="AnimationNodeAnimation" id="AnimationNodeAnimation_1"]
animation = &"idle"

[sub_resource type="AnimationNodeAnimation" id="AnimationNodeAnimation_2"]
animation = &"move-forward"

[sub_resource type="AnimationNodeAnimation" id="AnimationNodeAnimation_3"]
animation = &"attack"

[sub_resource type="AnimationNodeAnimation" id="AnimationNodeAnimation_4"]
animation = &"died"

[sub_resource type="AnimationNodeStateMachineTransition" id="AnimationNodeStateMachineTransition_5"]
xfade_time = 0.08

[sub_resource type="AnimationNodeStateMachineTransition" id="AnimationNodeStateMachineTransition_6"]
xfade_time = 0.08

[sub_resource type="AnimationNodeStateMachineTransition" id="AnimationNodeStateMachineTransition_7"]
xfade_time = 0.08

[sub_resource type="AnimationNodeStateMachineTransition" id="AnimationNodeStateMachineTransition_8"]
xfade_time = 0.08

[sub_resource type="AnimationNodeStateMachineTransition" id="AnimationNodeStateMachineTransition_9"]
xfade_time = 0.08

[sub_resource type="AnimationNodeStateMachineTransition" id="AnimationNodeStateMachineTransition_10"]
xfade_time = 0.08

[sub_resource type="AnimationNodeStateMachineTransition" id="AnimationNodeStateMachineTransition_11"]
xfade_time = 0.08

[sub_resource type="AnimationNodeStateMachineTransition" id="AnimationNodeStateMachineTransition_12"]
xfade_time = 0.08

[sub_resource type="AnimationNodeStateMachineTransition" id="AnimationNodeStateMachineTransition_13"]
xfade_time = 0.08

[sub_resource type="AnimationNodeStateMachine" id="AnimationNodeStateMachine_14"]
states/idle/node = SubResource("AnimationNodeAnimation_1")
states/idle/position = Vector2(0, 0)
states/move-forward/node = SubResource("AnimationNodeAnimation_2")
states/move-forward/position = Vector2(200, 0)
states/attack/node = SubResource("AnimationNodeAnimation_3")
states/attack/position = Vector2(400, 0)
states/died/node = SubResource("AnimationNodeAnimation_4")
states/died/position = Vector2(600, 0)
transitions = [&"idle", &"move-forward", SubResource("AnimationNodeStateMachineTransition_5"), &"idle", &"attack", SubResource("AnimationNodeStateMachineTransition_6"), &"idle", &"died", SubResource("AnimationNodeStateMachineTransition_7"), &"move-forward", &"idle", SubResource("AnimationNodeStateMachineTransition_8"), &"move-forward", &"attack", SubResource("AnimationNodeStateMachineTransition_9"), &"move-forward", &"died", SubResource("AnimationNodeStateMachineTransition_10"), &"attack", &"idle", SubResource("AnimationNodeStateMachineTransition_11"), &"attack", &"move-forward", SubResource("AnimationNodeStateMachineTransition_12"), &"attack", &"died", SubResource("AnimationNodeStateMachineTransition_13")]

[sub_resource type="AnimationNodeTimeScale" id="AnimationNodeTimeScale_15"]


[resource]
resource_local_to_scene = true
nodes/StateMachine/node = SubResource("AnimationNodeStateMachine_14")
nodes/StateMachine/position = Vector2(-400, 0)
nodes/Speed/node = SubResource("AnimationNodeTimeScale_15")
nodes/Speed/position = Vector2(-150, 0)
node_connections = [&"Speed", 0, &"StateMachine", &"output", 0, &"Speed"]
